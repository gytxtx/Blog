---
import type { GetStaticPaths } from 'astro';
import Archive from '../../../../layouts/Archive.astro';
import { getPosts, PAGE_SIZE } from '../../../../lib/posts';
import { groupPostsByYear } from '../../../../lib/post-groups';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const groups = groupPostsByYear(posts);
  const years = groups.map(({ year }) => year);
  return groups.flatMap(({ year, posts: yearPosts }) => {
    // 第一页由 archive/[year]/index.astro 负责
    return paginate(yearPosts, { pageSize: PAGE_SIZE, params: { year: String(year) }, props: { years } }).filter(
      (p) => p.props.page.currentPage >= 2,
    );
  });
}) satisfies GetStaticPaths;

const { page, years } = Astro.props;
const { year } = Astro.params;
---

<Archive year={Number(year)} years={years} posts={page.data} total={page.total} current={page.currentPage} totalPages={page.lastPage} />

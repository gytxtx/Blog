---
import Archive from '../../../layouts/Archive.astro';
import { getPosts, PAGE_SIZE } from '../../../lib/posts';
import { groupPostsByYear } from '../../../lib/post-groups';

export async function getStaticPaths() {
  const posts = await getPosts();
  const groups = groupPostsByYear(posts);
  const years = groups.map(({ year }) => year);
  return groups.map(({ year, posts }) => ({
    params: { year: String(year) },
    props: { year, years, posts },
  }));
}

const { year, years, posts } = Astro.props;
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const pagePosts = posts.slice(0, PAGE_SIZE);
---

<Archive year={year} years={years} posts={pagePosts} total={posts.length} current={1} totalPages={totalPages} />

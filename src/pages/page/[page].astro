---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Pager from '../../components/Pager.astro';
import { getPostsForIndex, PAGE_SIZE } from '../../lib/posts';
import { SITE } from '../../consts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPostsForIndex();
  // 第一页由首页 / 负责，这里只生成 /page/2/ 起
  return paginate(posts, { pageSize: PAGE_SIZE }).filter((p) => p.props.page.currentPage >= 2);
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Base title={`文章 - 第 ${page.currentPage} 页 - ${SITE.title}`} description="所有文章">
  <div class="content">
    <div>
      {page.data.map((p) => <PostCard post={p} />)}
    </div>
    <Pager current={page.currentPage} total={page.lastPage} base="/" />
  </div>
</Base>

---
import Base from '../../../../layouts/Base.astro';
import Pager from '../../../../components/Pager.astro';
import PostList from '../../../../components/PostList.astro';
import ArchiveHead from '../../../../components/ArchiveHead.astro';
import { getPosts, PAGE_SIZE } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))].sort((a, b) => b - a);
  return years.map((year) => ({
    params: { year: String(year) },
    props: { year, posts: posts.filter((p) => p.data.pubDate.getUTCFullYear() === year) },
  }));
}

const { year, posts } = Astro.props;
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const pagePosts = posts.slice(0, PAGE_SIZE);
---

<Base title={`${year} 年文章 - KFACBT 的博客`} description={`${year} 年发布的所有文章`}>
  <div class="content">
    <ArchiveHead year={year} />
    <h2 class="group-head">{year}<span>{posts.length} 篇</span></h2>
    <PostList posts={pagePosts} />
    <Pager current={1} total={totalPages} base={`/blog/archive/${year}`} />
  </div>
</Base>

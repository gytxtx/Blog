---
import type { GetStaticPaths } from 'astro';
import Base from '../../../../../layouts/Base.astro';
import Pager from '../../../../../components/Pager.astro';
import PostList from '../../../../../components/PostList.astro';
import ArchiveHead from '../../../../../components/ArchiveHead.astro';
import { getPosts, PAGE_SIZE } from '../../../../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))].sort((a, b) => b - a);
  return years.flatMap((year) => {
    const yearPosts = posts.filter((p) => p.data.pubDate.getUTCFullYear() === year);
    // 第一页由 archive/[year]/index.astro 负责
    return paginate(yearPosts, { pageSize: PAGE_SIZE, params: { year: String(year) } }).filter(
      (p) => p.props.page.currentPage >= 2,
    );
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { year } = Astro.params;
---

<Base title={`${year} 年文章 - 第 ${page.currentPage} 页 - KFACBT 的博客`} description={`${year} 年发布的所有文章`}>
  <div class="content">
    <ArchiveHead year={Number(year)} />
    <h2 class="group-head">{year}<span>{page.total} 篇</span></h2>
    <PostList posts={page.data} />
    <Pager current={page.currentPage} total={page.lastPage} base={`/blog/archive/${year}`} />
  </div>
</Base>

---
import { getPosts, postUrl, legacyPostUrl } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.flatMap((post) => {
    const legacy = legacyPostUrl(post);
    const monthly = legacy.replace(/^(\/blog\/\d{4}\/\d{2})\/\d{2}\//, '$1/');
    // 日级旧地址和曾使用的 /blog/ 年月地址都直接到最终文章地址，避免连续跳转。
    return [legacy, monthly].map((url) => ({
      params: { slug: url.replace(/^\/blog\//, '').replace(/\/$/, '') },
      props: { destination: postUrl(post) },
    }));
  });
}

return Astro.redirect(Astro.props.destination, 301);
---

---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../lib/posts';
import { groupPostsByCategory, groupPostsByYear } from '../../../lib/post-groups';
import { SITE } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return groupPostsByCategory(posts).map(({ slug, display, posts }) => ({
    params: { category: slug },
    props: { display, posts },
  }));
}

const { display, posts } = Astro.props;
const groups = groupPostsByYear(posts);
---

<Base title={`分类：${display} - ${SITE.title}`} description={`分类「${display}」下的所有文章`}>
  <div class="content">
    <header class="page-head">
      <h1>{display}</h1>
      <p>分类下共 {posts.length} 篇文章</p>
    </header>
    {
      groups.map(({ year: y, posts: yearPosts }) => {
        return (
          <>
            <h2 class="group-head">
              {y}
              <span>{yearPosts.length} 篇</span>
            </h2>
            <PostList posts={yearPosts} />
          </>
        );
      })
    }
  </div>
</Base>

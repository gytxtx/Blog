---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, categorySlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const byCat = new Map<string, { display: string; posts: typeof posts }>();
  for (const p of posts) {
    for (const c of p.data.categories) {
      const key = categorySlug(c);
      if (!byCat.has(key)) byCat.set(key, { display: c, posts: [] });
      byCat.get(key)!.posts.push(p);
    }
  }
  return [...byCat.entries()].map(([key, v]) => ({
    params: { category: key },
    props: { display: v.display, posts: v.posts },
  }));
}

const { display, posts } = Astro.props;
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))];
---

<Base title={`分类：${display} - KFACBT 的博客`} description={`分类「${display}」下的所有文章`}>
  <div class="content">
    <header class="page-head">
      <h1>{display}</h1>
      <p>分类下共 {posts.length} 篇文章</p>
    </header>
    {
      years.map((y) => {
        const yearPosts = posts.filter((p) => p.data.pubDate.getUTCFullYear() === y);
        return (
          <>
            <h2 class="group-head">
              {y}
              <span>{yearPosts.length} 篇</span>
            </h2>
            <PostList posts={yearPosts} />
          </>
        );
      })
    }
  </div>
</Base>

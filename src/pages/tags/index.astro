---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const tagMap = new Map<string, typeof posts>();
for (const p of posts) {
  for (const t of p.data.tags) {
    if (!tagMap.has(t)) tagMap.set(t, []);
    tagMap.get(t)!.push(p);
  }
}
const tags = [...tagMap.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
const anchor = (t: string) => t.toLowerCase().replace(/\s+/g, '-');
---

<Base title={`标签 - KFACBT 的博客`} description="所有标签">
  <div class="content">
    <header class="page-head">
      <h1>标签</h1>
      <div class="cloud">
        {
          tags.map(([t, ps]) => (
            <a href={`#${anchor(t)}`}>
              #{t}
              <sup>{ps.length}</sup>
            </a>
          ))
        }
      </div>
    </header>
    {
      tags.map(([t, ps]) => (
        <section>
          <h2 class="group-head" id={anchor(t)}>
            #{t}
            <span>{ps.length} 篇</span>
          </h2>
          <PostList posts={ps} fullDate />
        </section>
      ))
    }
  </div>
</Base>

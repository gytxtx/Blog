---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
import { groupPostsByTag } from '../../lib/post-groups';
import { SITE } from '../../consts';

const posts = await getPosts();
const tags = groupPostsByTag(posts);
const anchor = (t: string) => t.toLowerCase().replace(/\s+/g, '-');
---

<Base title={`标签 - ${SITE.title}`} description="所有标签">
  <div class="content">
    <header class="page-head">
      <h1>标签</h1>
      <div class="cloud">
        {
          tags.map(([t, ps]) => (
            <a href={`#${anchor(t)}`}>
              #{t}
              <sup>{ps.length}</sup>
            </a>
          ))
        }
      </div>
    </header>
    {
      tags.map(([t, ps]) => (
        <section>
          <h2 class="group-head" id={anchor(t)}>
            #{t}
            <span>{ps.length} 篇</span>
          </h2>
          <PostList posts={ps} fullDate />
        </section>
      ))
    }
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---

<Base title={`首页 - ${SITE.title}`}>
  <div class="content">
    <section class="hero">
      <h1>首页</h1>
      <p>这里是 KFACBT 的个人博客。</p>
      <p>主要分享一些技术文章，偶尔也会发一些日常。</p>
    </section>

    <h2>跳转</h2>
    <div class="btn-grid">
      <a class="btn primary" href="/blog/">文章</a>
      <a class="btn" href="/blog/tags/">标签</a>
      <a class="btn" href="/blog/about/">关于</a>
      <a class="btn" href="/blog/links/">友链</a>
    </div>

    <h2>其他</h2>
    <p>
      本站基于 <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> 构建，托管于
      <a href="https://pages.cloudflare.com/" target="_blank" rel="noopener">Cloudflare Pages</a>。
    </p>
    <p>
      同时，网站也在 GitHub 上开源。访问
      <a href="https://github.com/gytxtx/Blog/" target="_blank" rel="noopener">https://github.com/gytxtx/Blog/</a>
      以获取详细信息。
    </p>
  </div>
</Base>

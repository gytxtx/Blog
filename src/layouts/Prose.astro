---
import Base from './Base.astro';
import { SITE } from '../consts';

interface Props {
  frontmatter: { title: string };
}

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} - ${SITE.title}`}>
  <article class="content prose" data-pagefind-body>
    <slot />
  </article>
</Base>

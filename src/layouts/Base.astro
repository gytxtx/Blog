---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** 文章页传入：og:type 变为 article，并输出 article:* 元数据 */
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    section?: string;
    tags?: string[];
  };
}

const { title, description = SITE.description, ogImage = '/og/default.png', article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 开发时分享图使用本地端点，避免内容脚本读取尚未部署的线上图片。
const ogImageAbs = new URL(ogImage, import.meta.env.DEV ? Astro.url.origin : Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- 浏览器地址栏配色，主题脚本会按当前明暗改写 -->
    <meta name="theme-color" content="#fbfaf7" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime.toISOString()} />
          {article.modifiedTime && (
            <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
          )}
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <!-- 标题衬线字体：自托管子集，构建后按页面用字生成（src/integrations/serif-subset.mjs）。
         写在 inline style 里：文件构建完才存在，放进打包的 CSS 会被 Vite 当成未解析资源 -->
    <link rel="preload" href="/fonts/NotoSerifSC-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Noto Serif SC';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/NotoSerifSC-Bold.woff2') format('woff2');
      }
    </style>
    <script is:inline>
      // 主题三档切换：auto / light / dark，早于首帧执行避免闪白
      (function () {
        var apply = function (doc) {
          doc = doc || document;
          var mode = localStorage.getItem('theme') || 'auto';
          var dark =
            mode === 'dark' ||
            (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          doc.documentElement.dataset.theme = dark ? 'github-dark' : 'github-light';
          doc.documentElement.dataset.mode = mode;
          var meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#121412' : '#fbfaf7');
        };
        window.__applyTheme = apply;
        apply();
        // 站内跳转时先把主题写进新文档再换：换 <html> 属性那一刻若没有 data-theme，
        // 中间一次样式计算就会落到浅色，body 的颜色过渡随即从浅色渐变回来，深色下闪一下白
        document.addEventListener('astro:before-swap', function (e) { apply(e.newDocument); });
        // 「跟随系统」档下系统明暗变了要立刻跟上（giscus 靠 themechange 同步）
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if ((localStorage.getItem('theme') || 'auto') !== 'auto') return;
          apply();
          document.dispatchEvent(new CustomEvent('themechange'));
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
    <!-- Pagefind 资源由构建生成，开发模式的搜索弹窗显示预览提示 -->
    {import.meta.env.PROD && (
      <>
        <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
        <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
      </>
    )}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-29NRC21SS3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-29NRC21SS3');
      // ClientRouter 站内跳转不会重新加载页面，手动补发 page_view
      document.addEventListener('astro:after-swap', function () {
        gtag('event', 'page_view', { page_location: location.href, page_title: document.title });
      });
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { dropOffscreenTitles, markPageTurn, recordTitleSizes, setTitleScale } from '../lib/transitions';
      document.addEventListener('astro:before-preparation', markPageTurn);
      document.addEventListener('astro:after-preparation', dropOffscreenTitles);
      document.addEventListener('astro:after-preparation', recordTitleSizes);
      document.addEventListener('astro:after-swap', dropOffscreenTitles);
      document.addEventListener('astro:after-swap', setTitleScale);
    </script>
  </body>
</html>

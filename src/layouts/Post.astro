---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Giscus from '../components/Giscus.astro';
import Toc from '../components/Toc.astro';
import { Icon } from 'astro-icon/components';
import { authors } from '../data/authors';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import { titleMorph, titleTransitionName } from '../lib/transitions';
import { postUrl, legacyPostUrl, postOgPath, categorySlug, excerpt, wordCount, formatWords, type Post } from '../lib/posts';

interface Props {
  post: Post;
  readtime: number;
  headings: MarkdownHeading[];
  prev?: Post | null; // 更早一篇
  next?: Post | null; // 更新一篇
}

const { post, readtime, headings, prev, next } = Astro.props;
const author = authors[post.data.authors[0]] ?? { name: post.data.authors[0] };
const { updatedDate, heroImage } = post.data;
const description = post.data.description ?? excerpt(post, 160);
const words = await wordCount(post);
const ogImage = `/og/${postOgPath(post)}.png`;
// 结构化数据：搜索引擎识别为博客文章（schema.org BlogPosting）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (updatedDate ?? post.data.pubDate).toISOString(),
  url: new URL(postUrl(post), Astro.site).href,
  image: new URL(ogImage, Astro.site).href,
  author: { '@type': 'Person', name: author.name },
  publisher: { '@type': 'Person', name: author.name },
  inLanguage: 'zh-CN',
  wordCount: words,
  keywords: [...post.data.categories, ...post.data.tags].join(', ') || undefined,
};
---

<Base
  title={`${post.data.title} - KFACBT 的博客`}
  description={description}
  ogImage={ogImage}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: updatedDate,
    section: post.data.categories[0],
    tags: post.data.tags,
  }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="wrap post-layout">
    <header class="post-header" data-pagefind-body>
      <div class="meta" data-pagefind-ignore>
        {post.data.draft && <span class="draft">草稿</span>}
        <FormattedDate date={post.data.pubDate} />
        {post.data.categories.map((c) => <a href={`/category/${categorySlug(c)}/`}>{c}</a>)}
        <span>{formatWords(words)}</span>
        <span>{readtime} 分钟</span>
      </div>
      <h1 transition:name={titleTransitionName(post.data.slug)} transition:animate={titleMorph}>{post.data.title}</h1>
      <div class="byline" data-pagefind-ignore>
        {author.avatar && <Image src={author.avatar} alt="" width={24} height={24} densities={[1, 2]} />}
        <b>{author.name}</b>
        {updatedDate && (
          <span>
            更新于 <FormattedDate date={updatedDate} />
          </span>
        )}
      </div>
    </header>

    <div class="post-main">
      {heroImage && <Image class="hero-image" src={heroImage} width={1020} height={510} alt="" />}

      <Toc headings={headings} variant="inline" />

      <article class="prose" data-pagefind-body>
        <slot />
      </article>

      <nav class="post-pn" aria-label="上一篇下一篇">
        {
          prev ? (
            <a href={postUrl(prev)}>
              <span class="dir"><Icon class="arr" name="lucide:arrow-left" />上一篇</span>
              <b>{prev.data.title}{prev.data.draft && <span class="draft">草稿</span>}</b>
            </a>
          ) : (
            <div>
              <span class="dir"><Icon class="arr" name="lucide:arrow-left" />上一篇</span>
              <span class="none">已是最早一篇</span>
            </div>
          )
        }
        {
          next ? (
            <a href={postUrl(next)}>
              <span class="dir">下一篇<Icon class="arr" name="lucide:arrow-right" /></span>
              <b>{next.data.title}{next.data.draft && <span class="draft">草稿</span>}</b>
            </a>
          ) : (
            <div>
              <span class="dir">下一篇<Icon class="arr" name="lucide:arrow-right" /></span>
              <span class="none">已是最新一篇</span>
            </div>
          )
        }
      </nav>

      {post.data.comments && <Giscus term={legacyPostUrl(post).slice(1)} />}
    </div>

    <aside class="post-side">
      <Toc headings={headings} variant="side" />
    </aside>
  </div>
</Base>

<script>
  // glightbox 图片灯箱：正文图片自动包一层链接（等价于 Material 的 glightbox 插件）
  import GLightbox from 'glightbox';
  import 'glightbox/dist/css/glightbox.min.css';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.prose > img, .prose p > img').forEach((img) => {
      if (img.closest('a')) return;
      const a = document.createElement('a');
      a.href = (img as HTMLImageElement).src;
      a.className = 'glightbox';
      a.setAttribute('data-gallery', 'post');
      img.replaceWith(a);
      a.appendChild(img);
    });
    GLightbox({ selector: '.glightbox' });
  });

  // 目录高亮：取视口上方最后一个越过的标题
  let spy: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    if (spy) window.removeEventListener('scroll', spy);
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    if (!links.length) return (spy = null);
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    spy = () => {
      let i = targets.findLastIndex((t) => t && t.getBoundingClientRect().top < 120);
      if (i < 0) i = 0;
      links.forEach((a, j) => a.classList.toggle('active', j === i));
    };
    window.addEventListener('scroll', spy, { passive: true });
    spy();
  });
</script>

---
interface Props {
  current: number;
  total: number;
  base: string;
}

const { current, total, base } = Astro.props;
const href = (n: number) => (n === 1 ? `${base}/` : `${base}/page/${n}/`);
---

{
  total > 1 && (
    <nav class="pager" aria-label="分页">
      <span>
        {current > 1 && (
          <a href={href(current - 1)} rel="prev">
            ← 上一页
          </a>
        )}
      </span>
      <span>
        {current} / {total}
      </span>
      <span>
        {current < total && (
          <a href={href(current + 1)} rel="next">
            下一页 →
          </a>
        )}
      </span>
    </nav>
  )
}

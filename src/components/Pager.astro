---
import { Icon } from 'astro-icon/components';

interface Props {
  current: number;
  total: number;
  base: string;
}

const { current, total, base } = Astro.props;
// base 可能是 '/'（首页），去掉末尾斜杠再拼，避免生成 '//page/2/' 这种协议相对地址
const root = base.replace(/\/$/, '');
const href = (n: number) => (n === 1 ? `${root}/` : `${root}/page/${n}/`);
---

{
  total > 1 && (
    <nav class="pager" aria-label="分页">
      {current > 1 ? (
        <a href={href(current - 1)} rel="prev">
          <Icon class="arr" name="lucide:arrow-left" />较新
        </a>
      ) : (
        <span class="off"><Icon class="arr" name="lucide:arrow-left" />较新</span>
      )}
      <span>
        第 {current} / {total} 页
      </span>
      {current < total ? (
        <a href={href(current + 1)} rel="next">
          较旧<Icon class="arr" name="lucide:arrow-right" />
        </a>
      ) : (
        <span class="off">较旧<Icon class="arr" name="lucide:arrow-right" /></span>
      )}
    </nav>
  )
}

<style>
  .pager a,
  .pager .off {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .pager a:hover {
    text-decoration: none;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-10);
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .pager a,
  .pager .off {
    min-height: var(--control-size);
  }

  /* 禁用项：与背景混合后的实色，浅色约 2.5:1、深色约 3.3:1；
     WCAG 1.4.3 豁免不可交互组件，这里只保证「看得出是禁用」，不追求可读阈值。 */

  .pager .off {
    color: color-mix(in srgb, var(--muted) 60%, var(--bg));
  }
</style>

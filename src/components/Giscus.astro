---
// 用旧版 pathname 对应的搜索词固定评论标识，文章地址移除日期中的日后仍匹配同一讨论。
// giscus 的 pathname 映射会去掉开头的 /，所以传入的 term 也不带开头的 /。
import { Icon } from 'astro-icon/components';
interface Props {
  term: string;
}
const { term } = Astro.props;
---

<section class="giscus-wrap" aria-labelledby="__comments">
  <h2 id="__comments">评论</h2>
  <giscus-comments data-term={term}>
    <p class="comments-status" role="status" aria-live="polite">滚动到此处后加载评论。</p>
    <div class="giscus"></div>
    <p class="comments-help">
      <a href="https://github.com/gytxtx/Blog_Comments/discussions" target="_blank" rel="noopener noreferrer">在 GitHub 讨论区查看或留言<Icon name="lucide:arrow-up-right" class="arr" aria-hidden="true" /></a>
      <button class="ui-button" type="button" data-comments-retry hidden>重新加载评论</button>
    </p>
  </giscus-comments>
</section>

<script>
  import '../lib/giscus';
</script>

---
import { postUrl, formatDate, excerpt, categorySlug, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="post-card">
  <a class="card-title" href={postUrl(post)}>
    {post.data.title}{post.data.pin && <span class="pin-badge">置顶</span>}
  </a>
  <div class="card-meta">
    <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
    {post.data.categories.map((c) => <a class="chip" href={`/blog/category/${categorySlug(c)}/`}>{c}</a>)}
    {post.data.readtime && <span>{post.data.readtime} 分钟</span>}
  </div>
  <p class="card-excerpt">{excerpt(post)}</p>
</article>

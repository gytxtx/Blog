---
import { Icon } from 'astro-icon/components';
import FormattedDate from './FormattedDate.astro';
import { titleMorph, titleTransitionName } from '../lib/transitions';
import { postUrl, excerpt, categorySlug, readingTime, wordCount, formatWords, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const readtime = await readingTime(post);
const words = await wordCount(post);
const url = postUrl(post);
---

<article class="entry">
  <div class="meta">
    {post.data.pin && <span class="pin">置顶</span>}
    <FormattedDate date={post.data.pubDate} />
    {post.data.categories.map((c) => <a href={`/blog/category/${categorySlug(c)}/`}>{c}</a>)}
  </div>
  <h2 transition:name={titleTransitionName(post.data.slug)} transition:animate={titleMorph}><a href={url}>{post.data.title}</a></h2>
  <p>{excerpt(post)}</p>
  <div class="more">
    <span class="stats">
      <span>{formatWords(words)}</span>
      <span>{readtime} 分钟</span>
    </span>
    <a class="go" href={url}>阅读全文<Icon class="arr" name="lucide:arrow-right" /></a>
  </div>
</article>

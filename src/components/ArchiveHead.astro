---
interface Props {
  year: number;
  years: number[];
}

const { year, years } = Astro.props;
---

<header class="page-head">
  <h1>归档</h1>
  <nav class="years" aria-label="按年份">
    {
      years.map((y) => (
        <a href={`/archive/${y}/`} aria-current={y === year ? 'page' : undefined}>
          {y}
        </a>
      ))
    }
  </nav>
</header>

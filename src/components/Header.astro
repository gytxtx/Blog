---
import { SITE } from '../consts';

const nav = [
  { href: '/', label: '首页' },
  { href: '/blog/tags/', label: '标签' },
  { href: '/blog/about/', label: '关于' },
  { href: '/blog/links/', label: '友链' },
];
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/img/logo.jpg" alt="" width="28" height="28" />
      {SITE.title}
    </a>
    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href="https://www.travellings.cn/go.html" target="_blank" rel="noopener">开往 ↗</a>
    </nav>
    <div class="header-actions">
      <button id="search-btn" type="button" aria-label="搜索" title="搜索 (Ctrl+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
      </button>
      <button id="theme-btn" type="button" aria-label="切换主题" title="切换主题">
        <svg class="i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M3.5 3.5l1.5 1.5M19 19l1.5 1.5M1 12h2M21 12h2M3.5 20.5L5 19M19 5l1.5-1.5"></path></svg>
        <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </div>
  </div>
  <dialog id="search-dialog">
    <div id="pagefind-search"></div>
  </dialog>
</header>

<script>
  const PF_TRANSLATIONS = {
    placeholder: '搜索文章',
    clear_search: '清除',
    load_more: '加载更多结果',
    search_label: '搜索本站',
    zero_results: '没有找到 “[SEARCH_TERM]” 的结果',
    one_result: '为 “[SEARCH_TERM]” 找到 [COUNT] 个结果',
    many_results: '为 “[SEARCH_TERM]” 找到 [COUNT] 个结果',
    searching: '正在搜索 “[SEARCH_TERM]”…',
  };

  const MODES = ['auto', 'light', 'dark'] as const;

  function initHeader() {
    // 搜索弹窗（pagefind 产物仅在构建后存在，dev 下给出提示）
    const btn = document.getElementById('search-btn');
    const dlg = document.getElementById('search-dialog') as HTMLDialogElement | null;
    const el = document.getElementById('pagefind-search');
    if (btn && dlg && el) {
      if (window.PagefindUI && !el.dataset.pfInit) {
        el.dataset.pfInit = '1';
        new window.PagefindUI({ element: el, showImages: false, translations: PF_TRANSLATIONS });
      }
      btn.onclick = () => dlg.showModal();
      dlg.onclick = (e) => {
        if (e.target === dlg) dlg.close();
      };
    }

    // 主题三档循环：auto → light → dark
    const themeBtn = document.getElementById('theme-btn');
    themeBtn &&
      (themeBtn.onclick = () => {
        const cur = (localStorage.getItem('theme') || 'auto') as (typeof MODES)[number];
        const next = MODES[(MODES.indexOf(cur) + 1) % MODES.length];
        localStorage.setItem('theme', next);
        window.dispatchEvent(new CustomEvent('themechange'));
        (window as any).__applyTheme?.();
      });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

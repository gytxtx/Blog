---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { SITE } from '../consts';
import { getPosts } from '../lib/posts';

const latestYear = (await getPosts())[0]?.data.pubDate.getUTCFullYear();
const nav = [
  { href: '/', label: '首页' },
  { href: '/tags/', label: '标签' },
  { href: `/archive/${latestYear}/`, label: '归档', match: '/archive/' },
  { href: '/about/', label: '关于' },
  { href: '/links/', label: '友链' },
  { href: 'https://www.travellings.cn/go.html', label: '开往', external: true },
];
const current = Astro.url.pathname;
const isActive = (item: (typeof nav)[number]) =>
  item.href === '/' ? current === '/' : current.startsWith(item.match ?? item.href);
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <div class="wrap header-inner">
    <button id="nav-btn" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="site-nav">
      <Icon class="i-menu" name="lucide:menu" size={20} />
      <Icon class="i-close" name="lucide:x" size={20} />
    </button>
    <a class="brand" href="/">
      <Image src={logo} alt="" width={28} height={28} densities={[1, 2]} loading="eager" />
      {SITE.title}
    </a>
    <nav class="nav" id="site-nav" aria-label="主导航">
      {
        nav.map((item) =>
          item.external ? (
            <a class="ext" href={item.href} target="_blank" rel="noopener">
              {item.label}
              <Icon class="arr" name="lucide:arrow-up-right" />
            </a>
          ) : (
            <a href={item.href} aria-current={isActive(item) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>
    <div class="header-actions">
      <button id="search-btn" type="button" aria-label="搜索" title="搜索（Ctrl+K / ⌘K）">
        <Icon name="lucide:search" size={20} />
      </button>
      <button id="theme-btn" type="button" aria-label="切换主题" title="切换主题">
        <Icon class="i-auto" name="lucide:sun-moon" size={20} />
        <Icon class="i-light" name="lucide:sun" size={20} />
        <Icon class="i-dark" name="lucide:moon" size={20} />
      </button>
    </div>
  </div>
  <dialog id="search-dialog">
    <div id="pagefind-search"></div>
  </dialog>
</header>

<script>
  const PF_TRANSLATIONS = {
    placeholder: '搜索文章',
    clear_search: '清除',
    load_more: '加载更多结果',
    search_label: '搜索本站',
    zero_results: '没有找到 “[SEARCH_TERM]” 的结果',
    one_result: '为 “[SEARCH_TERM]” 找到 [COUNT] 个结果',
    many_results: '为 “[SEARCH_TERM]” 找到 [COUNT] 个结果',
    searching: '正在搜索 “[SEARCH_TERM]”…',
  };

  // 索引里为对齐中文分词插了零宽空格（scripts/pagefind-index.mjs），展示前去掉
  const stripZwsp = (s?: string) => s?.replaceAll('​', '');
  const processResult = (r: any) => {
    r.meta.title = stripZwsp(r.meta.title);
    r.excerpt = stripZwsp(r.excerpt);
    for (const sub of r.sub_results ?? []) {
      sub.title = stripZwsp(sub.title);
      sub.excerpt = stripZwsp(sub.excerpt);
    }
    return r;
  };

  const MODES = ['auto', 'light', 'dark'] as const;
  const MODE_LABELS = { auto: '跟随系统', light: '浅色', dark: '深色' };

  // 窄屏导航面板：开合状态挂在 .site-header 的 data-nav-open 上；翻页时顶栏整块换新，自然回到收起
  const setNav = (open: boolean) => {
    const header = document.querySelector('.site-header');
    const navBtn = document.getElementById('nav-btn');
    if (!header || !navBtn) return;
    header.toggleAttribute('data-nav-open', open);
    navBtn.setAttribute('aria-expanded', String(open));
    navBtn.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
  };
  const navOpen = () => !!document.querySelector('.site-header[data-nav-open]');

  function initHeader() {
    const navBtn = document.getElementById('nav-btn');
    const nav = document.getElementById('site-nav');
    if (navBtn && nav) {
      navBtn.onclick = () => setNav(!navOpen());
      nav.onclick = (e) => {
        if ((e.target as Element).closest('a')) setNav(false);
      };
    }

    // 搜索弹窗（pagefind 产物仅在构建后存在，dev 下给出提示）
    const btn = document.getElementById('search-btn');
    const dlg = document.getElementById('search-dialog') as HTMLDialogElement | null;
    const el = document.getElementById('pagefind-search');
    if (btn && dlg && el) {
      if (!window.PagefindUI) {
        el.textContent = '搜索索引在构建时生成，dev 下不可用：npm run build 后用 npm run preview 预览。';
      } else if (!el.dataset.pfInit) {
        el.dataset.pfInit = '1';
        new window.PagefindUI({
          element: el,
          showImages: false,
          translations: PF_TRANSLATIONS,
          processResult,
        });
      }
      btn.onclick = () => dlg.showModal();
      dlg.onclick = (e) => {
        if (e.target === dlg) dlg.close();
      };
    }

    // 主题三档循环：auto → light → dark；aria-label 报出当前档位
    const themeBtn = document.getElementById('theme-btn');
    if (themeBtn) {
      const current = () => (localStorage.getItem('theme') || 'auto') as (typeof MODES)[number];
      // 连点时多个过渡排队，被跳过的过渡其 swap 仍会执行且先后不定：每次 swap 都写入「最后一次点击的目标档」
      let target: (typeof MODES)[number] | null = null;
      const label = () => {
        const text = `主题：${MODE_LABELS[current()]}（点击切换）`;
        themeBtn.setAttribute('aria-label', text);
        themeBtn.title = text;
      };
      label();
      let latest: ViewTransition | null = null;
      themeBtn.onclick = () => {
        themeBtn.classList.add('switched');
        target = MODES[(MODES.indexOf(target ?? current()) + 1) % MODES.length];
        const swap = () => {
          if (target) localStorage.setItem('theme', target);
          (window as any).__applyTheme?.();
          document.dispatchEvent(new CustomEvent('themechange'));
          label();
        };
        // 支持 View Transitions 的浏览器里明暗整页交叉淡入，而不是各元素各自突变
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (document.startViewTransition && !reduced) {
          // 新旧两张截图都要在标记下拍（global.css 据此去掉过渡名）；连点时只由最后一次过渡摘掉标记
          const root = document.documentElement;
          root.dataset.themeSwitching = '';
          const vt = (latest = document.startViewTransition(swap));
          // 连点会让上一次过渡被跳过（AbortError），属正常情况，不往控制台抛
          vt.ready.catch(() => {});
          vt.finished
            .finally(() => {
              if (latest !== vt) return;
              delete root.dataset.themeSwitching;
              target = null;
            })
            .catch(() => {});
        } else {
          swap();
          target = null;
        }
      };
    }
  }

  document.addEventListener('astro:page-load', initHeader);

  // 导航面板：点面板外或按 Esc 收起
  document.addEventListener('click', (e) => {
    if (navOpen() && !(e.target as Element).closest('.site-header')) setNav(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !navOpen()) return;
    setNav(false);
    document.getElementById('nav-btn')?.focus();
  });

  // Ctrl+K / ⌘K 开关搜索弹窗。模块脚本只执行一次，监听挂在 document 上跨页面有效
  document.addEventListener('keydown', (e) => {
    if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'k') return;
    const dlg = document.getElementById('search-dialog') as HTMLDialogElement | null;
    if (!dlg) return;
    e.preventDefault();
    if (dlg.open) return dlg.close();
    dlg.showModal();
    dlg.querySelector<HTMLInputElement>('input')?.focus();
  });
</script>

---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { SITE } from '../consts';
import { getPosts } from '../lib/posts';

const latestYear = (await getPosts())[0]?.data.pubDate.getUTCFullYear();
const nav = [
  { href: '/', label: '首页' },
  { href: '/tags/', label: '标签' },
  { href: `/archive/${latestYear}/`, label: '归档', match: '/archive/' },
  { href: '/about/', label: '关于' },
  { href: '/links/', label: '友链' },
  { href: 'https://www.travellings.cn/go.html', label: '开往', external: true },
];
const current = Astro.url.pathname;
const isActive = (item: (typeof nav)[number]) =>
  item.href === '/' ? current === '/' : current.startsWith(item.match ?? item.href);
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <div class="wrap header-inner">
    <button class="ui-icon-button" id="nav-btn" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="site-nav">
      <Icon class="i-menu" name="lucide:menu" size={20} />
      <Icon class="i-close" name="lucide:x" size={20} />
    </button>
    <a class="brand" href="/">
      <Image src={logo} alt="" width={28} height={28} densities={[1, 2]} loading="eager" />
      {SITE.title}
    </a>
    <nav class="nav" id="site-nav" aria-label="主导航">
      {
        nav.map((item) =>
          item.external ? (
            <a class="ext" href={item.href} target="_blank" rel="noopener">
              {item.label}
              <Icon class="arr" name="lucide:arrow-up-right" />
            </a>
          ) : (
            <a href={item.href} aria-current={isActive(item) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>
    <div class="header-actions">
      <button class="ui-icon-button" id="search-btn" type="button" aria-label="搜索" title="搜索（Ctrl+K / ⌘K）">
        <Icon name="lucide:search" size={20} />
      </button>
      <button class="ui-icon-button" id="theme-btn" type="button" aria-label="切换主题" title="切换主题">
        <Icon class="i-auto" name="lucide:sun-moon" size={20} />
        <Icon class="i-light" name="lucide:sun" size={20} />
        <Icon class="i-dark" name="lucide:moon" size={20} />
      </button>
    </div>
  </div>
  <dialog id="search-dialog" aria-labelledby="search-title" data-search-enabled={import.meta.env.PROD}>
    <div class="search-heading">
      <h2 id="search-title">搜索本站</h2>
      <button class="ui-icon-button" id="search-close" type="button" aria-label="关闭搜索"><Icon name="lucide:x" size={20} /></button>
    </div>
    <div class="search-body">
      <p id="search-status" role="status" aria-live="polite"></p>
      <button class="ui-button" id="search-retry" type="button" hidden>重新加载搜索</button>
      <div id="pagefind-search"></div>
    </div>
  </dialog>
</header>

<script>
  import '../lib/header';
</script>
